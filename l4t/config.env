# Switch L4T (emisor). NO edites este archivo: ./install.sh crea config.local.env
# (gitignored) y ahí cambias lo que necesites. Los puertos/FEC deben coincidir con cachyos/.

PC_IP=                       # IP de CachyOS (install.sh te la pregunta)

# --- Modo tcp ---
TCP_PORT=4713
TUNNEL_LATENCY_MSEC=         # vacío = default de PipeWire. Prueba: 20, 40, 80

# --- Modo roc ---
ROC_SOURCE_PORT=10001
ROC_REPAIR_PORT=10002
ROC_FEC=rs8m                 # disable | rs8m | ldpc  (igual que en CachyOS)
