# CachyOS (receptor). NO edites este archivo: ./install.sh crea config.local.env
# (gitignored) y ahí cambias lo que necesites. Los puertos/FEC deben coincidir con l4t/.

LAN_SUBNET=192.168.1.0/24    # Quién puede conectarse por TCP (install.sh lo detecta)

# --- Modo tcp ---
TCP_PORT=4713

# --- Modo roc ---
ROC_SOURCE_PORT=10001
ROC_REPAIR_PORT=10002
ROC_LATENCY_MSEC=60          # buffer del receptor. Menos = menos delay, más cortes
ROC_FEC=rs8m                 # disable | rs8m | ldpc  (igual que en la Switch)
